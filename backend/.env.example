# ── App ────────────────────────────────────────────
APP_NAME=QUESH
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:8000

# ── Database (PostgreSQL) ───────────────────────────
DATABASE_URL=postgresql+asyncpg://quesh:quesh@localhost:5432/quesh
DATABASE_URL_SYNC=postgresql://quesh:quesh@localhost:5432/quesh

# ── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Claude AI (Anthropic) ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# ── Z-API (WhatsApp) ────────────────────────────────
# Create account at: https://z-api.io
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_BASE_URL=https://api.z-api.io

# ── Twilio (SMS) ────────────────────────────────────
# Create account at: https://twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1...

# ── Asaas (Payments) ────────────────────────────────
# Dashboard: https://asaas.com
ASAAS_API_KEY=$aas_...
ASAAS_BASE_URL=https://api.asaas.com/v3
