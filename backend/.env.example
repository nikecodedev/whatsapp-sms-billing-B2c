# ── App ────────────────────────────────────────────
APP_NAME=QUESH
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:8000

# ── Database (PostgreSQL) ───────────────────────────
# Ports match docker-compose.yml (5433/6380 to avoid clashing with a
# host Postgres/Redis already on the default 5432/6379).
DATABASE_URL=postgresql+asyncpg://quesh:quesh@localhost:5433/quesh
DATABASE_URL_SYNC=postgresql://quesh:quesh@localhost:5433/quesh

# ── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ── Claude AI (Anthropic) ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# ── Z-API (WhatsApp) ────────────────────────────────
# Create account at: https://z-api.io
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_BASE_URL=https://api.z-api.io

# ── Twilio (SMS + Voice) ────────────────────────────
# Create account at: https://twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1...
# Optional: dedicated voice-capable number (falls back to TWILIO_FROM_NUMBER).
# Must support Voice in the Twilio console.
TWILIO_VOICE_FROM_NUMBER=
TWILIO_VOICE_LANGUAGE=pt-BR
TWILIO_VOICE_NAME=Polly.Camila-Neural

# Public URL Twilio uses to fetch TwiML and post call-status callbacks.
# In local dev: expose backend via ngrok and paste the https URL here.
# Falls back to APP_BASE_URL if empty (which won't work for Twilio in local dev).
PUBLIC_BASE_URL=

# ── Asaas (Payments) ────────────────────────────────
# Dashboard: https://asaas.com
ASAAS_API_KEY=$aas_...
ASAAS_BASE_URL=https://api.asaas.com/v3
