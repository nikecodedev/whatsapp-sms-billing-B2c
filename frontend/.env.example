# Tenant UUID — replace with the tenant ID returned from POST /api/v1/tenants
VITE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Backend URL. Leave EMPTY for local dev (the Vite proxy handles it).
# In production set it to the deployed backend, e.g. https://quesh-backend.up.railway.app
VITE_API_URL=
